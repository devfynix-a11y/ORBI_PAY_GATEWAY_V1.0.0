{
  "name": "orbi-pay-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ORBI Pay Gateway enterprise rail integration service for external collections, payouts, refunds, provider callbacks, and Core settlement signaling.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "secrets:migrate-service-registry": "tsx src/tools/migrateServiceRegistrySecrets.ts",
    "test": "tsx --test --test-force-exit tests/**/*.test.ts",
    "check": "npm run build && npm test",
    "openapi:check": "tsx --test --test-force-exit tests/openApiSpec.test.ts",
    "sdk:node:build": "npm --prefix sdk/node run build",
    "sdk:node:test": "npm --prefix sdk/node test",
    "sdk:node:check": "npm --prefix sdk/node run check",
    "sdk:node:pack": "cd sdk/node && npm pack --dry-run",
    "sdk:python:test": "python -m unittest discover -s sdk/python/tests",
    "sdk:python:check": "python -m unittest discover -s sdk/python/tests",
    "sdk:publish": "powershell -ExecutionPolicy Bypass -File scripts/publish-sdks.ps1",
    "example:merchant-checkout:check": "npm --prefix examples/merchant-checkout run check",
    "example:seller-linking:check": "npm --prefix examples/seller-linking run check",
    "example:saccos-member-payments:check": "npm --prefix examples/saccos-member-payments run check"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
