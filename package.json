{
  "name": "orbi-pay-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ORBI Pay Gateway enterprise rail integration service for external collections, payouts, refunds, provider callbacks, and Core settlement signaling.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "tsx --test --test-force-exit tests/**/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "22.x"
  }
}
