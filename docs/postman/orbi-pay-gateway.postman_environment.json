{
  "name": "ORBI Pay Gateway Sandbox",
  "_postman_variable_scope": "environment",
  "_postman_exported_using": "ORBI Pay Gateway",
  "values": [
    {
      "key": "base_url",
      "value": "https://sandbox-pay.orbifinancial.com",
      "enabled": true
    },
    {
      "key": "service_key",
      "value": "orbi_sandbox_replace_me",
      "enabled": true,
      "type": "secret"
    },
    {
      "key": "operator_key",
      "value": "orbi_operator_replace_me",
      "enabled": true,
      "type": "secret"
    },
    {
      "key": "intent_id",
      "value": "pi_replace_me",
      "enabled": true
    },
    {
      "key": "escrow_id",
      "value": "esc_replace_me",
      "enabled": true
    },
    {
      "key": "consent_id",
      "value": "consent_replace_me",
      "enabled": true
    },
    {
      "key": "delivery_id",
      "value": "whdel_replace_me",
      "enabled": true
    }
  ]
}
