NODE_ENV=production
PAYMENT_GATEWAY_PORT=3100
PAYMENT_GATEWAY_PUBLIC_BASE_URL=https://pay.orbifinancial.com
PAYMENT_GATEWAY_PROVIDER_MODE=live

# Core private callback target. In separate-VM deployments, use the secure Core external root.
ORBI_CORE_INTERNAL_BASE_URL=https://api.orbifinancial.com
ORBI_CORE_TRUSTED_GATEWAY_EVENT_PATH=/api/internal/gateway/provider-events
ORBI_CORE_CALLBACK_TIMEOUT_MS=7500

# Signed internal worker identity. Must match Core WORKER_SIGNING_SECRET.
PAYMENT_GATEWAY_WORKER_ID=orbi-payment-gateway
PAYMENT_GATEWAY_WORKER_SCOPES=gateway:events:write
WORKER_SIGNING_SECRET=
WORKER_KEY_ID=payment-gateway-v1

# Current mTLS plan:
# false = signed HMAC over private/localhost network.
# true = direct client cert for HTTPS Core internal URL.
# For proxy mTLS, terminate/verify certs in Nginx and forward Core's trusted mTLS headers.
PAYMENT_GATEWAY_INTERNAL_MTLS_ENABLED=false
PAYMENT_GATEWAY_INTERNAL_MTLS_CERT_PATH=
PAYMENT_GATEWAY_INTERNAL_MTLS_KEY_PATH=
PAYMENT_GATEWAY_INTERNAL_MTLS_CA_PATH=
PAYMENT_GATEWAY_INTERNAL_MTLS_REJECT_UNAUTHORIZED=true

# Provider credentials. Leave empty until real provider onboarding is complete.
SELCOM_API_BASE_URL=
SELCOM_API_KEY=
SELCOM_API_SECRET=
MPESA_TZ_API_BASE_URL=
MPESA_TZ_API_KEY=
MPESA_TZ_API_SECRET=
