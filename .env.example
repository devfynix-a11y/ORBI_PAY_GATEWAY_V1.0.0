NODE_ENV=production
PAYMENT_GATEWAY_PORT=3100
PAYMENT_GATEWAY_PUBLIC_BASE_URL=https://pay.orbifinancial.com
PAYMENT_GATEWAY_PROVIDER_MODE=live
PAYMENT_GATEWAY_CREDENTIAL_MODE=tokenized
PAYMENT_GATEWAY_REQUIRE_STRONG_CUSTOMER_AUTH=true
PAYMENT_GATEWAY_FINANCIAL_SIGNATURE_TOLERANCE_SECONDS=300
PAYMENT_GATEWAY_FINANCIAL_NONCE_TTL_SECONDS=600
PAYMENT_GATEWAY_FINANCIAL_NONCE_MAX_ENTRIES=100000
PAYMENT_GATEWAY_FINANCIAL_RATE_LIMIT_WINDOW_SECONDS=60
PAYMENT_GATEWAY_FINANCIAL_RATE_LIMIT_MAX_REQUESTS=120
PAYMENT_GATEWAY_FINANCIAL_RATE_LIMIT_MAX_SUBJECTS=50000
PAYMENT_GATEWAY_SERVICE_ACCESS_TOKEN_SECRET=
PAYMENT_GATEWAY_SERVICE_ACCESS_TOKEN_TTL_SECONDS=900
PAYMENT_GATEWAY_PROVIDER_MANIFEST_PATH=config/providers.json
PAYMENT_GATEWAY_SERVICE_REGISTRY_PATH=config/services.json
DATABASE_URL=
ORBI_SECRET_ENCRYPTION_KEY=
PAYMENT_GATEWAY_WEBHOOK_DELIVERY_STORE_PATH=data/webhook-deliveries.json
PAYMENT_GATEWAY_OPERATOR_DISCOVERY_API_KEY=

# Developer Portal control plane. These belong to the Pay Gateway container,
# not the Vercel/static portal frontend. The portal UI only proxies requests.
PAYMENT_GATEWAY_PORTAL_AUTH_SECRET=
PAYMENT_GATEWAY_PORTAL_SESSION_TTL_SECONDS=28800
PAYMENT_GATEWAY_PORTAL_MFA_FRESHNESS_SECONDS=300
PAYMENT_GATEWAY_PORTAL_MFA_MAX_FAILED_ATTEMPTS=5
PAYMENT_GATEWAY_PORTAL_MFA_LOCKOUT_SECONDS=900
PAYMENT_GATEWAY_PORTAL_EMAIL_VERIFICATION_TTL_SECONDS=900
PAYMENT_GATEWAY_PORTAL_EMAIL_VERIFICATION_RESEND_SECONDS=60
PAYMENT_GATEWAY_OIDC_IDENTITY_ISSUER=https://auth.orbifinancial.com/realms/orbi
PAYMENT_GATEWAY_OIDC_IDENTITY_AUDIENCE=orbi-core
PAYMENT_GATEWAY_FINANCIAL_TOKEN_AUDIENCE=orbi-pay-api
PAYMENT_GATEWAY_FINANCIAL_TOKEN_TTL_SECONDS=300
PAYMENT_GATEWAY_OAUTH_PAR_TTL_SECONDS=90
PAYMENT_GATEWAY_ORBI_TALK_ENABLED=false
ORBI_TALK_GATEWAY_URL=https://talk.orbifinancial.com
ORBI_TALK_MESSAGING_INTENT_PATH=/api/send-email
ORBI_TALK_GATEWAY_API_KEY=
ORBI_TALK_GATEWAY_USER_EMAIL=
PAYMENT_GATEWAY_PORTAL_TOTP_ISSUER=ORBI Pay Developer Portal
PAYMENT_GATEWAY_PORTAL_ADMIN_EMAIL=
PAYMENT_GATEWAY_PORTAL_ADMIN_NAME=ORBI Admin
PAYMENT_GATEWAY_PORTAL_ADMIN_ROLE=admin
PAYMENT_GATEWAY_PORTAL_ADMIN_PASSWORD_SALT=
PAYMENT_GATEWAY_PORTAL_ADMIN_PASSWORD_HASH=
PAYMENT_GATEWAY_PORTAL_ADMIN_PASSWORD_ITERATIONS=210000
PAYMENT_GATEWAY_PORTAL_ADMIN_TOTP_SECRET=
PAYMENT_GATEWAY_PORTAL_ADMIN_MFA_REQUIRED=false

# Sandbox/dev operator tools for OBP user/account/entitlement testing.
# Keep false/unset in production unless intentionally running sandbox operations.
PAYMENT_GATEWAY_OBP_SANDBOX_TOOLS_ENABLED=false

# Core private callback target. In separate-VM deployments, use the secure Core external root.
ORBI_CORE_INTERNAL_BASE_URL=https://api.orbifinancial.com
PAYMENT_GATEWAY_ALLOW_PRIVATE_HTTP_CORE=false
ORBI_CORE_TRUSTED_GATEWAY_EVENT_PATH=/api/internal/gateway/provider-events
ORBI_CORE_TRUSTED_SERVICE_PAYMENT_REQUEST_PATH=/api/internal/pay-gateway/service-payment-requests
ORBI_CORE_TRUSTED_PAYSAFE_BALANCE_PATH=/api/internal/pay-gateway/paysafe-balances
ORBI_CORE_TRUSTED_BUSINESS_REGISTRATION_PATH=/api/internal/pay-gateway/business/registrations
ORBI_CORE_TRUSTED_PAYMENT_PROFILE_PATH=/api/internal/pay-gateway/payment-profiles
ORBI_CORE_TRUSTED_MERCHANT_ORDER_PAYMENT_STATUS_PATH=/api/internal/pay-gateway/merchant-order-payment-status
ORBI_CORE_TRUSTED_MERCHANT_SETTLEMENTS_PATH=/api/internal/pay-gateway/merchant-settlements
ORBI_CORE_CALLBACK_TIMEOUT_MS=7500

# Signed internal worker identity. Must match Core WORKER_SIGNING_SECRET.
PAYMENT_GATEWAY_WORKER_ID=orbi-payment-gateway
PAYMENT_GATEWAY_WORKER_SCOPES=gateway:events:write,gateway:service-payments:write,gateway:service-payments:result,gateway:identity:read,gateway:paysafe-balances:read,gateway:business-registration:write,gateway:payment-profiles:write,gateway:merchant-payments:read,gateway:merchant-settlements:read
WORKER_SIGNING_SECRET=
WORKER_KEY_ID=payment-gateway-v1

# Trusted product/service registry. ORBI Shop should call Pay Gateway with its own key.
ORBI_SHOP_PAY_API_KEY_TOKEN_REF=env://ORBI_SHOP_PAY_API_KEY
ORBI_SHOP_PAY_API_KEY=
ORBI_SHOP_PAY_WEBHOOK_SECRET_TOKEN_REF=env://ORBI_SHOP_PAY_WEBHOOK_SECRET
ORBI_SHOP_PAY_WEBHOOK_SECRET=
ORBI_SHOP_PAY_WEBHOOK_URL=https://shop.orbifinancial.com/api/orbi-pay/webhooks
ORBI_SHOP_MERCHANT_ID=

# Dedicated sandbox runtime. These values are for the separate
# pay-gateway-sandbox process/container only. Do not point sandbox to live DB,
# live worker secrets, or live merchant keys.
PAYMENT_GATEWAY_SANDBOX_PORT=3101
PAYMENT_GATEWAY_SANDBOX_PUBLIC_BASE_URL=https://sandbox-pay.orbifinancial.com
PAYMENT_GATEWAY_SANDBOX_PROVIDER_MODE=sandbox
PAYMENT_GATEWAY_SANDBOX_DATABASE_URL=
PAYMENT_GATEWAY_SANDBOX_SECRET_ENCRYPTION_KEY=
PAYMENT_GATEWAY_SANDBOX_OPERATOR_DISCOVERY_API_KEY=
PAYMENT_GATEWAY_SANDBOX_WORKER_ID=orbi-payment-gateway-sandbox
PAYMENT_GATEWAY_SANDBOX_WORKER_SIGNING_SECRET=
PAYMENT_GATEWAY_SANDBOX_WORKER_KEY_ID=payment-gateway-sandbox-v1
ORBI_CORE_SANDBOX_INTERNAL_BASE_URL=
ORBI_SHOP_SANDBOX_PAY_API_KEY=
ORBI_SHOP_SANDBOX_PAY_WEBHOOK_SECRET=
ORBI_SHOP_SANDBOX_PAY_WEBHOOK_URL=https://shop.orbifinancial.com/api/orbi-pay/sandbox/webhooks
ORBI_SHOP_SANDBOX_MERCHANT_ID=

# Direct mTLS for Pay Gateway -> ORBI Core callbacks.
# HMAC remains mandatory; mTLS adds transport-level service identity.
PAYMENT_GATEWAY_INTERNAL_MTLS_ENABLED=true
PAYMENT_GATEWAY_INTERNAL_MTLS_CERT_PATH=/opt/orbi/mtls/pay-gateway-client.crt
PAYMENT_GATEWAY_INTERNAL_MTLS_KEY_PATH=/opt/orbi/mtls/pay-gateway-client.key
PAYMENT_GATEWAY_INTERNAL_MTLS_CA_PATH=/opt/orbi/mtls/orbi-internal-ca.crt
PAYMENT_GATEWAY_INTERNAL_MTLS_REJECT_UNAUTHORIZED=true

# Provider token bindings are defined by the manifest env names.
# Example only; replace with real provider-specific env names from your manifest.
PROVIDER_API_BASE_URL=
PROVIDER_CREDENTIAL_TOKEN_REF=
PROVIDER_WEBHOOK_SECRET_TOKEN_REF=
PROVIDER_3DS_PROFILE_ID=

# Traditional switch example variables. Use only when your manifest selects ISO8583/VPN/mTLS profiles.
BANK_SWITCH_TLS_ENDPOINT=
BANK_SWITCH_HOST=
BANK_SWITCH_PORT=
BANK_SWITCH_MTLS_PROFILE=
BANK_SWITCH_VPN_PROFILE=
BANK_SWITCH_ISO8583_PROFILE=
BANK_SWITCH_CREDENTIAL_TOKEN_REF=
BANK_SWITCH_MESSAGE_AUTH_TOKEN_REF=

# NMB OBP sandbox profile. Use sandbox-only credentials here.
NMB_OBP_SANDBOX_BASE_URL=https://obp-api-sandbox.nmbbank.co.tz
NMB_OBP_SANDBOX_CREDENTIAL_TOKEN_REF=env://NMB_OBP_SANDBOX_CONSUMER_KEY
NMB_OBP_SANDBOX_CREDENTIAL_METADATA={"consumerIdEnv":"NMB_OBP_SANDBOX_CONSUMER_ID","consumerSecretEnv":"NMB_OBP_SANDBOX_CONSUMER_SECRET"}
NMB_OBP_SANDBOX_WEBHOOK_SECRET_TOKEN_REF=env://NMB_OBP_SANDBOX_WEBHOOK_SECRET
NMB_OBP_SANDBOX_CONSUMER_ID=
NMB_OBP_SANDBOX_CONSUMER_KEY=
NMB_OBP_SANDBOX_CONSUMER_SECRET=
NMB_OBP_SANDBOX_WEBHOOK_SECRET=
NMB_OBP_SANDBOX_DIRECT_LOGIN_TOKEN=
NMB_OBP_SANDBOX_USERNAME=
NMB_OBP_SANDBOX_PASSWORD=

# Future NMB/TIPS sponsored participant production profile placeholders.
NMB_TIPS_BASE_URL=
NMB_TIPS_CREDENTIAL_TOKEN_REF=
NMB_TIPS_WEBHOOK_SECRET_TOKEN_REF=
NMB_TIPS_ISO20022_PROFILE=
NMB_TIPS_CLEARING_NETWORK_PROFILE=
NMB_TIPS_ORBI_PARTICIPANT_ID=
NMB_TIPS_SPONSOR_PARTICIPANT_ID=
NMB_TIPS_MTLS_PROFILE=
