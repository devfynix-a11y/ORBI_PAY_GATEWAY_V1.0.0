{
  "providers": [
    {
      "code": "provider-code",
      "displayName": "Provider Display Name",
      "rail": "MOBILE_MONEY",
      "protocol": "REST_HMAC",
      "protocolProfile": "provider-rest-hmac-v1",
      "countries": ["TZ"],
      "currencies": ["TZS"],
      "operations": ["collection", "payout", "refund"],
      "baseUrlEnv": "PROVIDER_API_BASE_URL",
      "credentialTokenRefEnv": "PROVIDER_CREDENTIAL_TOKEN_REF",
      "webhookSecretTokenRefEnv": "PROVIDER_WEBHOOK_SECRET_TOKEN_REF",
      "threeDsProfileIdEnv": "PROVIDER_3DS_PROFILE_ID",
      "operationEndpoints": {
        "collection": { "method": "POST", "path": "/collections" },
        "payout": { "method": "POST", "path": "/payouts" },
        "refund": { "method": "POST", "path": "/refunds" }
      },
      "webhookStatusField": "status",
      "webhookReferenceFields": ["reference", "order_id", "transid"],
      "webhookEventIdFields": ["event_id", "transid", "reference"],
      "webhookSignature": {
        "algorithm": "sha256",
        "signatureHeader": "x-provider-signature",
        "timestampHeader": "x-provider-timestamp",
        "toleranceSeconds": 300,
        "signedPayloadFormat": "timestamp.raw"
      }
    },
    {
      "code": "tips-neighbor-bank",
      "displayName": "TIPS Neighbor Bank Clearing Profile",
      "rail": "BANK",
      "protocol": "ISO20022_REST_XML",
      "protocolProfile": "tips-iso20022-pacs-v1",
      "countries": ["TZ"],
      "currencies": ["TZS"],
      "operations": ["collection", "payout", "refund"],
      "baseUrlEnv": "TIPS_NEIGHBOR_BANK_BASE_URL",
      "credentialTokenRefEnv": "TIPS_NEIGHBOR_BANK_CREDENTIAL_TOKEN_REF",
      "webhookSecretTokenRefEnv": "TIPS_NEIGHBOR_BANK_WEBHOOK_SECRET_TOKEN_REF",
      "connection": {
        "iso20022ProfileEnv": "TIPS_ISO20022_PROFILE",
        "clearingNetworkProfileEnv": "TIPS_CLEARING_NETWORK_PROFILE",
        "participantIdEnv": "TIPS_ORBI_PARTICIPANT_ID",
        "mtlsProfileEnv": "TIPS_MTLS_PROFILE",
        "vpnProfileEnv": "TIPS_PRIVATE_CONNECTIVITY_PROFILE"
      },
      "operationEndpoints": {
        "collection": { "method": "POST", "path": "/iso20022/pacs008", "idempotencyHeader": "Idempotency-Key" },
        "payout": { "method": "POST", "path": "/iso20022/pacs008", "idempotencyHeader": "Idempotency-Key" },
        "refund": { "method": "POST", "path": "/iso20022/pacs004", "idempotencyHeader": "Idempotency-Key" }
      },
      "webhookStatusField": "status",
      "webhookReferenceFields": ["endToEndId", "transactionId", "reference"],
      "webhookEventIdFields": ["messageId", "eventId", "transactionId"],
      "webhookSignature": {
        "algorithm": "sha256",
        "signatureHeader": "x-tips-signature",
        "timestampHeader": "x-tips-timestamp",
        "toleranceSeconds": 300,
        "signedPayloadFormat": "timestamp.raw"
      }
    },
    {
      "code": "bank-switch-code",
      "displayName": "Bank Switch Display Name",
      "rail": "BANK",
      "protocol": "ISO8583_TCP_TLS",
      "protocolProfile": "bank-switch-iso8583-profile-v1",
      "countries": ["TZ"],
      "currencies": ["TZS"],
      "operations": ["collection", "payout"],
      "baseUrlEnv": "BANK_SWITCH_TLS_ENDPOINT",
      "credentialTokenRefEnv": "BANK_SWITCH_CREDENTIAL_TOKEN_REF",
      "webhookSecretTokenRefEnv": "BANK_SWITCH_MESSAGE_AUTH_TOKEN_REF",
      "connection": {
        "hostEnv": "BANK_SWITCH_HOST",
        "portEnv": "BANK_SWITCH_PORT",
        "mtlsProfileEnv": "BANK_SWITCH_MTLS_PROFILE",
        "vpnProfileEnv": "BANK_SWITCH_VPN_PROFILE",
        "iso8583ProfileEnv": "BANK_SWITCH_ISO8583_PROFILE"
      },
      "operationEndpoints": {
        "collection": { "method": "POST", "path": "iso8583://0200" },
        "payout": { "method": "POST", "path": "iso8583://0200" }
      }
    }
  ]
}
